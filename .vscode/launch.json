{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API: Launch (HTTPS)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-api",
      "program": "${workspaceFolder}/src/3DLoads.Api/bin/Debug/net8.0/3DLoads.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/3DLoads.Api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7273;http://localhost:5194"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "API: Attach to Running Process",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ]
}
