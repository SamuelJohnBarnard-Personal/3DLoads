{
  "name": "3dloads-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently --kill-others --names api,web \"dotnet run --project ../3DLoads.Api --no-launch-profile -- --urls http://localhost:5195\" \"ng serve --proxy-config proxy.conf.json --host 127.0.0.1 --port 4202\"",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "@angular/common": "^22.1.0",
